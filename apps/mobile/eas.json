{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "env": {
        "DATA_URL": "https://REPLACE_ME.github.io/branche/data",
        "SITE_URL": "https://REPLACE_ME.github.io/branche",
        "API_URL": "https://REPLACE_ME.onrender.com"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": { "production": {} }
}
